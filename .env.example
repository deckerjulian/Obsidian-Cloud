# ─────────────────────────────────────────────────────────────────────────────
# Obsidian-Cloud backend configuration. Copy to `.env` and adjust.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the deployment (the allowed browser origin for CORS). The
# realtime WebSocket relay authorizes by token, not by Origin.
PUBLIC_URL=http://localhost:8080
NODE_ENV=development
PORT=3000
# Set to true ONLY when the backend sits behind a reverse proxy (Caddy/nginx)
# and is not directly reachable: rate limiting then uses X-Forwarded-For.
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────────────────────
# docker-compose builds the Postgres container and the DATABASE_URL below from
# these (override for a non-default DB password in production).
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=obsidian
POSTGRES_DB=obsidian_cloud
# When running via docker-compose, host is `postgres`. Locally use `localhost`.
DATABASE_URL=postgresql://obsidian:obsidian@localhost:5432/obsidian_cloud?schema=public

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=604800      # seconds (7 days)

# ── Authentication providers ────────────────────────────────────────────────
# Comma-separated, in priority order. `local` should stay enabled so an admin
# can always log in even if the directory server is unreachable.
AUTH_PROVIDERS=local

# ── LDAP / Active Directory (only used when `ldap` is in AUTH_PROVIDERS) ──────
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=example,dc=org
LDAP_BIND_CREDENTIALS=admin
LDAP_SEARCH_BASE=ou=people,dc=example,dc=org
# {{username}} is substituted with the login name.
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=cn
LDAP_TLS=false
# Optional: members of this group get isAdmin=true on login.
LDAP_ADMIN_GROUP=

# First-run bootstrap admin (created if no users exist).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme
