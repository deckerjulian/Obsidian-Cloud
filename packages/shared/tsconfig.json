{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emit CommonJS so the NestJS (CJS) backend can require it directly, while
    // the esbuild/Vite bundlers (plugin, web) consume it just as happily.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/__tests__"]
}
